# Copy this file to ".env" (same folder) and change the values. Never commit ".env".

# "development" for your own computer, "production" for a deployed server.
# In production the app REFUSES to start unless JWT_SECRET is a real random secret.
APP_ENV=development

# A relative SQLite path means "inside the project folder", whichever folder you start the server from.
# DATABASE_URL=sqlite:///./krishiassist.db

# Create a secret with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60

# Websites allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sign-in protection: failed attempts allowed per e-mail, and per address, in the time window.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
REGISTER_MAX_PER_HOUR=10
# AI need analyses allowed per farmer per hour.
NEED_MAX_PER_HOUR=30

# Optional AI assistant (the rule engine works without it).
OPENROUTER_API_KEY=
LLM_MODEL=
