 function AssistantPage({messages,text,setText,onSend,busy,t,lang}:{messages:{from:'user'|'bot';text:string}[];text:string;setText:(s:string)=>void;onSend:(e:FormEvent)=>void;busy:boolean;t:any;lang:Lang}){return <section className="section page assistantPage"><div className="assistantIntro"><p className="eyebrow dark">FARMER SUPPORT</p><h2>{t.assistant}</h2><p>{t.assistantSub}</p></div><div className="chatBox"><div className="chatMessages">{!messages.length&&<div className="welcomeMessage"><b>{lang==='hi'?'नमस्ते।':'Namaste.'}</b><p>{lang==='hi'?'आप योजना, पात्रता, दस्तावेज़, सिंचाई, बीज, मिट्टी, मशीनरी या खेती से जुड़े सामान्य सवाल पूछ सकते हैं।':'Ask about schemes, eligibility, documents, irrigation, seeds, soil, machinery or general farming support.'}</p></div>}{messages.map((m,i)=><div key={i} className={`bubble ${m.from}`}>{m.text}</div>)}{busy&&<div className="bubble bot typing">Thinking from verified scheme data…</div>}</div><div className="assistantHint">{t.sourceNote}</div><form onSubmit={onSend} className="chatInput"><input value={text} onChange={e=>setText(e.target.value)} placeholder={t.askPlaceholder}/><button className="primary" disabled={busy}>{busy?'…':t.send}</button></form></div></section>}
 
